<!doctype html>
<html>
<head>
    <title>Journalite</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <script src="https://kit.fontawesome.com/c56b547e95.js" crossorigin="anonymous"></script>    
    <link rel="stylesheet" href="style.css">
    <style>
      body{
        background-image: url(https://images.unsplash.com/photo-1603484477859-abe6a73f9366?ixlib=rb-4.1.0&q=85&fm=jpg&crop=entropy&cs=srgb&dl=sj-objio-XFWiZTa2Ub0-unsplash.jpgimg/crumple.jpg); 
        background-size: cover;
      }
    </style>
  </head>
<body>

<div class="container">
    <div class="page-header text-center">
        <h1><span class="fa-solid fa-book-open"></span>Profile Page<span class="fa-solid fa-book-open"></span></h1>
        <a href="/logout" class="btn btn-default btn-sm">Logout</a>
    </div>

    <div class="row">

        <!-- LOCAL INFORMATION -->
        <div class="col-sm-6">
            <div class="well">
                <h3><span class="fa fa-user"></span> Local</h3>

                <% if (user.local.email) { %>
                    <p>
                        <strong>id</strong>: <%= user._id %><br>
                        <strong>email</strong>: <%= user.local.email %><br>
                        <strong>password</strong>: <%= user.local.password %>
                    </p>

                    <a href="/unlink/local" class="btn btn-default">Unlink</a>
                <% } else { %>
                    <a href="/connect/local" class="btn btn-default">Connect Local</a>
                <% } %>

            </div>
        </div>


        <div class="col-sm-6 entries">
          <h3>Messages</h3>
          <ul class="messages">
          <% for(var i=0; i<messages.length; i++) {%>
            <li class="message">
              <span><%= messages[i].title %></span>
              <span class="date"><%= messages[i].date %></span>
              <span><%= messages[i].msg %></span>
              <span><%= messages[i].entry1 %></span>
              <span><button class="archive" aria-hidden="true">Archive</button></span>
              <!-- <span><i class="fa fa-thumbs-down" aria-hidden="true"></i></span> -->
              <span><i class="fa-solid fa-trash" aria-hidden="true"></i></span>
            </li>
          <% } %>
          </ul>


          <!-- if conditional to disable the form and enable a button with JS to perform a put. 
          Could add a class to submit button in case we wanted a put
          Then event listener would be lookoing for that class and if it doesn't find it it won't add that event listener.
          Modify put code to save the fields that you're modifiyng.
          In findOneAndUpdate just find the date and other fields should be in their place.
         -->

          <h2>Add a message</h2>
        <% if (user.local.email) { %>
          <form action="/messages" method="POST">
            <input type="text" value="<%= user.local.email %>" name="name">
            <textarea name="entry1" rows="5" cols="50"><%=current?.entry1%></textarea>
            <input type="text" placeholder="message" name="msg">
            <input type="date" placeholder="Enter Date" name="date" required>
            <button type="submit">Submit</button>
          </form>
        </div>
        <% } %>

</div>
</div>

<script src="main.js"></script>

</body>
</html>
